  },
  {
   "id": 95,
   "kind": "para",
   "start": 13799,
   "end": 13861,
   "text": "Train with **dense annotations only** (sparse auto-generated):",
   "tokens": []
  },
  {
   "id": 96,
   "kind": "para",
   "start": 14262,
   "end": 14311,
   "text": "Train with **both sparse and dense annotations**:",
   "tokens": []
  },
  {
   "id": 97,
   "kind": "heading",
