   "end": 17152,
   "text": "- **Sample frames**: Key frames from the episode with progress/stage labels",
   "tokens": []
  },
  {
   "id": 112,
   "kind": "heading",
   "start": 17154,
   "end": 17181,
   "text": "### Visualization Arguments",
   "tokens": []
  },
  {
   "id": 113,
   "kind": "table",
   "start": 17183,
   "end": 17269,
   "text": "| Argument               | Description                                               |",
   "tokens": []
  },
  {
   "id": 114,
   "kind": "table",
   "start": 17357,
   "end": 17443,
