  {
   "id": 106,
   "kind": "heading",
   "start": 15723,
   "end": 15755,
   "text": "## Step 4: Visualize Predictions",
   "tokens": []
  },
  {
   "id": 107,
   "kind": "para",
   "start": 15757,
   "end": 15921,
   "text": "Use ⟦0⟧ with ⟦1⟧ to visualize model predictions (and, if available, annotation-derived targets) without writing a parquet file.",
   "tokens": [
    "`compute_rabc_weights.py`",
