   "text": "| Tasks         | 50 dual-arm manipulation tasks                           |",
   "tokens": []
  },
  {
   "id": 9,
   "kind": "table",
   "start": 3098,
   "end": 3174,
   "text": "| Robot         | Aloha-AgileX bimanual (14 DOF, 7 per arm)                |",
   "tokens": []
  },
  {
   "id": 10,
   "kind": "table",
   "start": 3175,
   "end": 3251,
   "text": "| Action space  | 14-dim joint-space, continuous in ⟦0⟧              |",
   "tokens": [
    "`[-1, 1]`"
   ]
  },
  {
   "id": 11,
   "kind": "table",
   "start": 3252,
   "end": 3328,
   "text": "| Cameras       | ⟦0⟧, ⟦1⟧, ⟦2⟧             |",
   "tokens": [
    "`head_camera`",
    "`left_camera`",
    "`right_camera`"
   ]
  },
  {
   "id": 12,
   "kind": "table",
   "start": 3329,
   "end": 3405,
   "text": "| Simulator     | SAPIEN (not MuJoCo)                                      |",
   "tokens": []
  },
  {
   "id": 13,
   "kind": "table",
   "start": 3406,
   "end": 3482,
   "text": "| Eval protocol | 100 episodes/task, 50 demo_clean demonstrations          |",
