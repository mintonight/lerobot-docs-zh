   "start": 1924,
   "end": 1938,
   "text": "# RoboTwin 2.0",
   "tokens": []
  },
  {
   "id": 1,
   "kind": "para",
   "start": 1940,
   "end": 2268,
   "text": "RoboTwin 2.0 is a **large-scale dual-arm manipulation benchmark** built on the SAPIEN physics engine. It provides a standardized evaluation protocol for bimanual robotic policies across 50 tasks (as of upstream ⟦0⟧) with strong domain randomization (clutter, lighting, background, tabletop height, and language instructions).",
   "tokens": [
    "`main`"
   ]
  },
  {
   "id": 2,
   "kind": "list",
   "start": 2270,
   "end": 2442,
   "text": "- Paper: [RoboTwin 2.0: A Scalable Data Generator and Benchmark with Strong Domain Randomization for Robust Bimanual Robotic Manipulation](⟦0⟧)",
   "tokens": [
    "https://arxiv.org/abs/2506.18088"
   ]
  },
  {
   "id": 3,
   "kind": "list",
   "start": 2443,
   "end": 2528,
   "text": "- GitHub: [RoboTwin-Platform/RoboTwin](⟦0⟧)",
   "tokens": [
    "https://github.com/RoboTwin-Platform/RoboTwin"
   ]
  },
  {
   "id": 4,
   "kind": "list",
   "start": 2529,
   "end": 2634,
   "text": "- Leaderboard: [robotwin-platform.github.io/leaderboard](⟦0⟧)",
   "tokens": [
    "https://robotwin-platform.github.io/leaderboard"
   ]
  },
  {
   "id": 5,
   "kind": "list",
   "start": 2635,
   "end": 2730,
   "text": "- Dataset: [lerobot/robotwin_unified](⟦0⟧)",
   "tokens": [
    "https://huggingface.co/datasets/lerobot/robotwin_unified"
   ]
  },
  {
   "id": 6,
   "kind": "heading",
   "start": 2854,
   "end": 2865,
   "text": "## Overview",
   "tokens": []
  },
  {
   "id": 7,
   "kind": "table",
