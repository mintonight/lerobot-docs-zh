   "id": 47,
   "kind": "para",
   "start": 7058,
   "end": 7135,
   "text": "Evaluate a policy on a single task with the official protocol (100 episodes):",
   "tokens": []
  },
  {
   "id": 48,
   "kind": "heading",
   "start": 7308,
   "end": 7335,
   "text": "### Single-task quick check",
   "tokens": []
  },
