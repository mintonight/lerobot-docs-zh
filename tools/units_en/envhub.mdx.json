   "tokens": []
  },
  {
   "id": 52,
   "kind": "para",
   "start": 9738,
   "end": 9788,
   "text": "For better performance with multiple environments:",
   "tokens": []
  },
  {
   "id": 53,
   "kind": "heading",
   "start": 9963,
   "end": 9986,
   "text": "## URL Format Reference",
   "tokens": []
  },
  {
   "id": 54,
   "kind": "para",
   "start": 9988,
   "end": 10033,
   "text": "The hub URL format supports several patterns:",
   "tokens": []
  },
  {
   "id": 55,
   "kind": "table",
   "start": 10035,
   "end": 10133,
   "text": "| Pattern              | Description                    | Example                                |",
   "tokens": []
  },
  {
   "id": 56,
   "kind": "table",
   "start": 10233,
   "end": 10331,
   "text": "| ⟦0⟧          | Load ⟦1⟧ from main branch | ⟦2⟧        |",
   "tokens": [
    "`user/repo`",
    "`env.py`",
