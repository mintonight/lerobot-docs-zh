   ]
  },
  {
   "id": 57,
   "kind": "table",
   "start": 10332,
   "end": 10430,
   "text": "| ⟦0⟧ | Load from specific revision    | ⟦1⟧   |",
   "tokens": [
    "`user/repo@revision`",
    "`make_env(\"lerobot/pusht-env@main\")`"
   ]
  },
  {
   "id": 58,
   "kind": "table",
   "start": 10431,
   "end": 10529,
   "text": "| ⟦0⟧     | Load custom file               | ⟦1⟧    |",
   "tokens": [
