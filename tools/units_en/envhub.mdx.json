   ]
  },
  {
   "id": 25,
   "kind": "list",
   "start": 5159,
   "end": 5229,
   "text": "- Must expose a ⟦0⟧ function",
   "tokens": [
    "`make_env(n_envs: int, use_async_envs: bool)`"
   ]
  },
  {
   "id": 26,
   "kind": "list",
   "start": 5230,
   "end": 5267,
   "text": "- This function should return one of:",
   "tokens": []
  },
  {
   "id": 27,
   "kind": "list",
   "start": 5268,
   "end": 5310,
   "text": "  - A ⟦0⟧ (most common)",
   "tokens": [
    "`gym.vector.VectorEnv`"
   ]
  },
  {
   "id": 28,
   "kind": "list",
   "start": 5311,
