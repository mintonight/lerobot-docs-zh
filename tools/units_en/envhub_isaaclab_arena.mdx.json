   "id": 51,
   "kind": "para",
   "start": 12248,
   "end": 12270,
   "text": "Clone our EnvHub repo:",
   "tokens": []
  },
  {
   "id": 52,
   "kind": "para",
   "start": 12345,
   "end": 12497,
   "text": "Modify the ⟦0⟧ file based on your new environment.\n[Upload](⟦1⟧) your modified repo to HuggingFace EnvHub.",
   "tokens": [
    "`example_envs.yaml`",
    "./envhub#step-3-upload-to-the-hub"
   ]
  },
  {
   "id": 53,
   "kind": "para",
   "start": 12499,
   "end": 12728,
   "text": "⟦0⟧\n  Your IsaacLab Arena environment code must be locally available during\n  evaluation. Users can clone your environment repository separately, or you can\n  bundle the environment code and assets directly in your EnvHub repo.",
   "tokens": [
    "<Tip>"
   ]
  },
