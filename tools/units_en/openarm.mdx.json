   "text": "## Troubleshooting",
   "tokens": []
  },
  {
   "id": 71,
   "kind": "heading",
   "start": 10400,
   "end": 10427,
   "text": "### No Response from Motors",
   "tokens": []
  },
  {
   "id": 72,
   "kind": "list",
   "start": 10429,
   "end": 10462,
   "text": "1. Check power supply connections",
   "tokens": []
  },
